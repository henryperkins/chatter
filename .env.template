# Azure OpenAI Configuration
AZURE_OPENAI_KEY=your_azure_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=o1-deployment
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Model Defaults
DEFAULT_MODEL_NAME=Azure o1
DEFAULT_MODEL_TYPE=o1-preview
DEFAULT_MAX_TOKENS=200000
DEFAULT_MAX_COMPLETION_TOKENS=100000
DEFAULT_REASONING_EFFORT=medium
DEFAULT_TEMPERATURE=1.0  # Must be 1.0 for o1 models

# Security
ENCRYPTION_KEY=your_32_byte_fernkey_key_here

# Core Application Settings
FLASK_ENV=development
FLASK_DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-min-12-chars

# Database Configuration
DATABASE_URI=postgresql://user:password@localhost:5432/dbname
