# Required Azure OpenAI Settings
AZURE_OPENAI_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
  # e.g. o1-east2
AZURE_OPENAI_API_VERSION=2025-01-01-preview
  # Latest version for o3-mini

# Microsoft Entra ID Authentication (Optional)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Model Settings (Optional)
MODEL_NAME=o1  # o3-mini, o1, o1-preview, o1-mini
DEFAULT_MODEL_NAME=Default Model
DEFAULT_MODEL_DESCRIPTION=Default model description

# O-series Model Settings
DEFAULT_MAX_COMPLETION_TOKENS=100000  # Max 100,000 for o3-mini/o1
DEFAULT_REASONING_EFFORT=high  # low, medium, or high

# Legacy Model Settings (for non-o-series models)
DEFAULT_TEMPERATURE=1.0  # Not supported by o-series models
DEFAULT_MAX_TOKENS=16384
  # Use DEFAULT_MAX_COMPLETION_TOKENS for o-series

# Feature Flags
DEFAULT_REQUIRES_O1_HANDLING=false
DEFAULT_SUPPORTS_STREAMING=true

# Core Application Settings
FLASK_ENV=development
FLASK_DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-min-12-chars

# Security Settings
ENCRYPTION_KEY=your-encryption-key-here
